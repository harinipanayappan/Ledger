PORT=4000

# Postgres
DATABASE_URL=postgres://watchlist_user:watchlist_pass@localhost:5432/smart_watchlist

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=change-this-dev-secret
JWT_EXPIRES_IN=7d

# Change-detection / staleness tuning
STALE_THRESHOLD_MS=10000
DEBOUNCE_WINDOW_MS=750
SIGNIFICANCE_Z_SCORE=1.5

# Tick generator
TICK_INTERVAL_MS=400
SPIKE_PROBABILITY=0.05

# CORS
CLIENT_ORIGIN=http://localhost:5173
